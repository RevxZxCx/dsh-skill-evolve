{
  "name": "dsh-skill-evolve",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "description": "DSH plugin: detect repeated tool procedures, propose them as skills, gate writes on evidence, and age them out when they stop being used.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "self-evolution"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-commands": ">=0.1.0",
    "@deepseek-ai/dsh-session": ">=0.1.0",
    "@deepseek-ai/dsh-skill": ">=0.1.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
